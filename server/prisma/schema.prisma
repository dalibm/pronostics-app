generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PickPeriod {
  DAILY
  WEEKLY
}

enum PickStatus {
  PENDING
  WON
  LOST
  PUSH
  VOID
}

model Pick {
  id         String     @id @default(cuid())
  period     PickPeriod @default(DAILY)
  date       DateTime   @db.Date
  matchTime  DateTime
  sport      String
  league     String?
  event      String
  market     String
  selection  String
  odds       Float?
  confidence Int
  reasoning  String     @db.Text
  sourceUrls String[]
  createdAt  DateTime   @default(now())

  // Champs machine-readable nécessaires pour vérifier automatiquement le
  // résultat réel du match une fois joué (voir src/lib/checkResults.ts).
  // Nullables : les pronostics générés avant cet ajout n'ont pas ces
  // données et resteront simplement PENDING (non gradables).
  sportKey     String?
  eventId      String?
  homeTeam     String?
  awayTeam     String?
  marketKey    String?
  selectionKey String?
  point        Float?

  status    PickStatus @default(PENDING)
  settledAt DateTime?

  @@index([period, date])
  @@index([status, matchTime])
}
