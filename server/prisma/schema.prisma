generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PickPeriod {
  DAILY
  WEEKLY
}

model Pick {
  id         String     @id @default(cuid())
  period     PickPeriod @default(DAILY)
  date       DateTime   @db.Date
  matchTime  DateTime
  sport      String
  league     String?
  event      String
  market     String
  selection  String
  odds       Float?
  confidence Int
  reasoning  String     @db.Text
  sourceUrls String[]
  createdAt  DateTime   @default(now())

  @@index([period, date])
}
